# SQLite locally; for production use postgresql://user:pass@host:5432/db (and set provider = "postgresql" in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Long random string used to sign admin sessions: openssl rand -base64 48
AUTH_SECRET=""
# Initial admin account, created/updated by `npm run db:seed` (password is stored only as a bcrypt hash)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD=""
NEXT_PUBLIC_SITE_URL="https://lendisk.ru"
# Where admin uploads (photos, GLB models, logo) are stored
UPLOAD_DIR="./storage/uploads"
# Optional: Telegram alerts about new leads. Create a bot via @BotFather, send it any message,
# then take chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
