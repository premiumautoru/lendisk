// Lendisk data model.
// Local development uses SQLite. For production switch `provider` to "postgresql"
// and point DATABASE_URL to a Postgres instance (Neon, Supabase, Render, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  sku             String         @unique
  name            String
  model           String
  brand           String
  diameter        Int
  width           Float
  pcd             String
  et              Float
  dia             Float
  finish          String
  finishCode      String         @default("")
  type            String         @default("Литой")
  axle            String?
  /// Comma-separated list of car makes the wheel fits (by bolt pattern)
  compatibleMakes String         @default("")
  price           Int
  oldPrice        Int?
  inStock         Boolean        @default(true)
  stockQty        Int            @default(0)
  /// Internal: source warehouse, shown only in admin
  warehouse       String         @default("")
  description     String         @default("")
  isPopular       Boolean        @default(false)
  isNew           Boolean        @default(false)
  published       Boolean        @default(true)
  model3dUrl      String?
  images          ProductImage[]
  leads           Lead[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([brand])
  @@index([diameter])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  /// 360° frame sequence images are flagged so the viewer can spin through them
  spin      Boolean @default(false)
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Lead {
  id        String   @id @default(cuid())
  /// podbor | product | callback
  type      String   @default("podbor")
  /// NEW | IN_WORK | CONTACTED | DONE
  status    String   @default("NEW")
  name      String
  phone     String
  carMake   String   @default("")
  carModel  String   @default("")
  vin       String   @default("")
  diameter  String   @default("")
  comment   String   @default("")
  note      String   @default("")
  consent   Boolean  @default(false)
  source    String   @default("")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  author    String
  car       String   @default("")
  text      String
  rating    Int      @default(5)
  isDemo    Boolean  @default(false)
  published Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sort      Int     @default(0)
  published Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Uploaded files (photos, logo, 3D models) when STORAGE_DRIVER=db — for hosts without a persistent disk
model StoredFile {
  id        String   @id @default(cuid())
  path      String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
